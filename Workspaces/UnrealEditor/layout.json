{
  "id": "ue5_default",
  "name": "Unreal Editor (Default)",
  "window": { "size": [1600, 900], "maximized": true },
  "central": "viewport",
  "corners": {
    "top_left": "left",
    "top_right": "right",
    "bottom_left": "bottom",
    "bottom_right": "right"
  },
  "docks": [
    { "panel": "place_actors",    "area": "left" },
    { "panel": "outliner",        "area": "right" },
    { "panel": "details",         "split": { "with": "outliner", "orientation": "vertical" } },
    { "panel": "content_browser", "area": "bottom" },
    { "panel": "output_log",      "tabify": "content_browser" },
    { "panel": "timeline",        "tabify": "content_browser", "active": true }
  ],
  "sizes": {
    "place_actors":    [200, 0],
    "outliner":        [340, 300],
    "details":         [340, 420],
    "content_browser": [0, 280]
  }
}
