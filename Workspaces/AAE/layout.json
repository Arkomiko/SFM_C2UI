{
  "id": "aae_default",
  "name": "After Effects (Default)",
  "window": { "size": [1600, 900], "maximized": true },
  "central": "viewport",
  "corners": { "top_left": "left", "top_right": "right", "bottom_left": "bottom", "bottom_right": "bottom" },
  "docks": [
    { "panel": "content_browser", "area": "left" },
    { "panel": "details",         "split": { "with": "content_browser", "orientation": "vertical" } },
    { "panel": "outliner",        "area": "right" },
    { "panel": "timeline",        "area": "bottom", "active": true },
    { "panel": "output_log",      "tabify": "timeline" }
  ],
  "sizes": { "content_browser": [300, 320], "outliner": [280, 0], "timeline": [0, 300] }
}
