/* =====================================================================
   C2UI base QSS template.
   @{token} placeholders are replaced by ThemeManager from the theme JSON.
   Derived tokens: @{x.hover} @{x.pressed} @{x.disabled} @{x.alpha50}
   Icons: url(icons:name.svg) -> tinted copies of Assets/icons/name.svg
   ===================================================================== */

* {
    font-family: "@{font.family}";
    font-size: @{font.size}pt;
    outline: none;
}

QMainWindow, QDialog, QWidget#central_placeholder {
    background: @{bg.window};
    color: @{text};
}
QWidget { color: @{text}; }
QWidget:disabled { color: @{text.dim}; }

/* ---------------- Menu bar & menus ------------------------------------ */
QMenuBar {
    background: @{bg.titlebar};
    color: @{text};
    border-bottom: 1px solid @{border};
    padding: 1px 4px;
}
QMenuBar::item { padding: 4px 8px; background: transparent; border-radius: @{radius.small}px; }
QMenuBar::item:selected { background: @{bg.hover}; color: @{text.bright}; }
QMenuBar::item:pressed  { background: @{bg.header}; }

QMenu {
    background: @{bg.menu};
    color: @{text};
    border: 1px solid @{border.light};
    padding: 4px;
}
QMenu::item { padding: 5px 28px 5px 26px; border-radius: @{radius.small}px; }
QMenu::item:selected { background: @{selection}; color: @{text.bright}; }
QMenu::item:disabled { color: @{text.dim}; }
QMenu::separator { height: 1px; background: @{border.light}; margin: 4px 6px; }
QMenu::icon { padding-left: 6px; }
QMenu::indicator { width: 14px; height: 14px; left: 6px; }
QMenu::right-arrow { image: url(icons:chevron_right.svg); width: 12px; height: 12px; }

/* ---------------- Tool bars ------------------------------------------- */
QToolBar {
    background: @{bg.window};
    border: none;
    border-bottom: 1px solid @{border};
    padding: 2px 6px;
    spacing: 2px;
}
QToolBar::separator { width: 1px; background: @{border.light}; margin: 5px 5px; }
QToolBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @{radius}px;
    padding: 4px 6px;
    color: @{text};
}
QToolBar QToolButton:hover   { background: @{bg.hover}; color: @{text.bright}; }
QToolBar QToolButton:pressed { background: @{bg.pressed}; }
QToolBar QToolButton:checked { background: @{bg.header}; border-color: @{accent}; color: @{text.bright}; }
QToolBar QToolButton::menu-indicator { image: none; }
QWidget#toolbarSpacer { background: transparent; }

/* ---------------- Generic tool buttons -------------------------------- */
QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: @{radius.small}px;
    padding: 3px;
    color: @{text};
}
QToolButton:hover   { background: @{bg.hover}; color: @{text.bright}; }
QToolButton:pressed { background: @{bg.pressed}; }
QToolButton:checked { background: @{bg.header}; border-color: @{border.light}; }
QToolButton::menu-indicator { image: url(icons:chevron_down.svg); width: 10px; height: 10px; subcontrol-position: right center; right: 2px; }
QToolButton[popupMode="1"] { padding-right: 14px; }
QToolButton#accentButton {
    background: @{accent};
    color: @{text.bright};
    border-radius: @{radius}px;
    padding: 4px 10px 4px 8px;
    font-weight: 600;
}
QToolButton#accentButton:hover   { background: @{accent.hover}; }
QToolButton#accentButton:pressed { background: @{accent.pressed}; }
QToolButton#categoryTab { padding: 3px 10px; border-radius: @{radius}px; color: @{text.dim}; }
QToolButton#categoryTab:checked { background: @{bg.header}; color: @{text.bright}; }

/* ---------------- Push buttons ---------------------------------------- */
QPushButton {
    background: @{bg.header};
    color: @{text};
    border: 1px solid @{border};
    border-radius: @{radius}px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover   { background: @{bg.hover}; color: @{text.bright}; }
QPushButton:pressed { background: @{bg.pressed}; }
QPushButton:default { border-color: @{accent}; }
QPushButton:disabled { color: @{text.dim}; background: @{bg.panel}; }

/* ---------------- Inputs ---------------------------------------------- */
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background: @{bg.input};
    color: @{text};
    border: 1px solid @{border};
    border-radius: @{radius.small}px;
    padding: 3px 6px;
    selection-background-color: @{selection};
    selection-color: @{text.bright};
}
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: @{border.focus}; }
QLineEdit:read-only { color: @{text.dim}; }
QLineEdit#searchField { padding-left: 4px; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::down-button { width: 0; border: none; }
QComboBox::drop-down { border: none; width: 18px; }
QComboBox::down-arrow { image: url(icons:chevron_down.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: @{bg.menu};
    border: 1px solid @{border.light};
    selection-background-color: @{selection};
    selection-color: @{text.bright};
    outline: none;
}
QCheckBox::indicator, QGroupBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid @{border.light};
    border-radius: 3px;
    background: @{bg.input};
}
QCheckBox::indicator:checked { background: @{accent}; border-color: @{accent}; image: url(icons:check.svg); }
QCheckBox::indicator:hover { border-color: @{accent.hover}; }
QRadioButton::indicator { width: 13px; height: 13px; border-radius: 7px; border: 1px solid @{border.light}; background: @{bg.input}; }
QRadioButton::indicator:checked { background: @{accent}; border: 3px solid @{bg.input}; }

QSlider::groove:horizontal { height: 4px; background: @{bg.base}; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0; background: @{text}; border-radius: 6px; }
QSlider::handle:horizontal:hover { background: @{text.bright}; }
QSlider::sub-page:horizontal { background: @{accent}; border-radius: 2px; }
QProgressBar { background: @{bg.base}; border: 1px solid @{border}; border-radius: @{radius.small}px; text-align: center; color: @{text}; }
QProgressBar::chunk { background: @{accent}; border-radius: @{radius.small}px; }

/* ---------------- Dock widgets & tabs --------------------------------- */
QDockWidget { titlebar-close-icon: none; titlebar-normal-icon: none; }
QDockWidget > QWidget { background: @{bg.panel}; }
QWidget#dockTitleBar {
    background: @{bg.tab.active};
    border-top: 2px solid @{accent};
    border-bottom: 1px solid @{border};
}
QLabel#dockTitleText { color: @{text.bright}; font-weight: 600; }
QWidget#dockTitleHidden { background: @{bg.panel}; }
QToolButton#dockFloatButton, QToolButton#dockCloseButton { padding: 2px; border-radius: 3px; }
QToolButton#dockCloseButton:hover { background: @{error}; }

QMainWindow::separator { background: @{bg.window}; width: 4px; height: 4px; }
QMainWindow::separator:hover { background: @{accent}; }
QSplitter::handle { background: @{border}; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }
QSplitter::handle:hover { background: @{accent}; }

QTabBar { background: @{bg.window}; qproperty-drawBase: 0; }
QTabBar::tab {
    background: @{bg.tab};
    color: @{text.dim};
    border: 1px solid @{border};
    border-bottom: none;
    border-top-left-radius: @{radius}px;
    border-top-right-radius: @{radius}px;
    padding: 5px 12px;
    margin-right: 1px;
    min-width: 60px;
}
QTabBar::tab:hover { color: @{text}; background: @{bg.hover}; }
QTabBar::tab:selected {
    background: @{bg.tab.active};
    color: @{text.bright};
    border-top: 2px solid @{accent};
}
QTabBar::close-button { image: url(icons:close.svg); subcontrol-position: right; }
QTabBar::close-button:hover { background: @{error}; border-radius: 3px; }
QTabBar QToolButton { background: @{bg.header}; border: 1px solid @{border}; }
QTabWidget::pane { border: 1px solid @{border}; background: @{bg.panel}; }

/* ---------------- Item views ------------------------------------------ */
QTreeView, QListView, QTableView, QTreeWidget, QListWidget {
    background: @{bg.panel};
    alternate-background-color: @{bg.alt};
    color: @{text};
    border: none;
    selection-background-color: @{selection};
    selection-color: @{text.bright};
    show-decoration-selected: 1;
}
QTreeView::item, QListView::item { padding: 3px 4px; border: none; }
QTreeView::item:hover, QListView::item:hover { background: @{bg.hover}; }
QTreeView::item:selected, QListView::item:selected { background: @{selection}; color: @{text.bright}; }
QTreeView::item:selected:!active, QListView::item:selected:!active { background: @{selection.inactive}; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { image: url(icons:chevron_right.svg); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { image: url(icons:chevron_down.svg); }
QHeaderView::section {
    background: @{bg.header};
    color: @{text.dim};
    border: none;
    border-right: 1px solid @{border};
    border-bottom: 1px solid @{border};
    padding: 4px 6px;
    font-weight: 600;
}
QListView#contentFiles { background: @{bg.base}; padding: 6px; }
QListView#contentFiles::item { border-radius: @{radius}px; padding: 4px; }
QListView#placeList::item { padding: 5px 6px; }

/* ---------------- Scroll bars (thin, UE5 like) ------------------------- */
QScrollBar:vertical { background: @{bg.scrollbar}; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @{fg.scrollbar}; min-height: 24px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:vertical:hover { background: @{text.dim}; }
QScrollBar:horizontal { background: @{bg.scrollbar}; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @{fg.scrollbar}; min-width: 24px; border-radius: 4px; margin: 2px; }
QScrollBar::handle:horizontal:hover { background: @{text.dim}; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollArea { border: none; background: transparent; }
QAbstractScrollArea::corner { background: @{bg.scrollbar}; }

/* ---------------- Status bar ------------------------------------------ */
QStatusBar { background: @{bg.titlebar}; color: @{text.dim}; border-top: 1px solid @{border}; }
QStatusBar::item { border: none; }
QLabel#statusSfm[state="online"]  { color: @{success}; font-weight: 600; }
QLabel#statusSfm[state="offline"] { color: @{text.dim}; }
QLabel#statusContext { color: @{accent.hover}; }

/* ---------------- Panel chrome ---------------------------------------- */
QWidget#panelToolbar { background: @{bg.panel}; border-bottom: 1px solid @{border}; }
QLabel#breadcrumb { color: @{text.dim}; }
QWidget#viewportHeader { background: @{bg.base.alpha80}; border-bottom: 1px solid @{border}; }
QToolButton#viewportToolButton { padding: 2px 6px; color: @{text}; }
QLabel#viewportInfoLabel { color: @{text.dim}; padding-right: 6px; }
QWidget#viewportCanvas { background: @{viewport.bg_bottom}; }

QToolButton#detailsSectionHeader {
    background: @{bg.header};
    border: none;
    border-bottom: 1px solid @{border};
    border-radius: 0;
    padding: 5px 8px;
    text-align: left;
    font-weight: 600;
    color: @{text.bright};
}
QWidget#detailsSectionBody { background: @{bg.panel}; }
QLineEdit#detailsName { font-weight: 600; }
QLabel#detailsType { color: @{text.dim}; }
QLabel#detailsEmpty { color: @{text.dim}; padding: 24px; }

QPlainTextEdit#outputLog {
    font-family: "@{font.mono}";
    background: @{bg.base};
    border: none;
    border-radius: 0;
}
QWidget#consoleRow { background: @{bg.panel}; border-top: 1px solid @{border}; }
QLineEdit#consoleInput { font-family: "@{font.mono}"; }

QToolBar#timelineToolbar { background: @{bg.panel}; border-bottom: 1px solid @{border}; }
QSpinBox#frameBox { min-width: 110px; font-family: "@{font.mono}"; }
QLabel#timelineMode { color: @{text.dim}; padding-right: 8px; }
QWidget#timelineView { background: @{timeline.bg}; }

/* ---------------- Tooltips & misc ------------------------------------- */
QToolTip {
    background: @{bg.tooltip};
    color: @{text};
    border: 1px solid @{border.light};
    padding: 4px 6px;
}
QGroupBox { border: 1px solid @{border}; border-radius: @{radius}px; margin-top: 10px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: @{text.dim}; }
QLabel { background: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: @{border}; }

/* ---------------- Notification banner --------------------------------- */
QWidget#banner {
    background: @{bg.header};
    border-bottom: 1px solid @{border};
    border-left: 3px solid @{accent};
}
QWidget#banner[kind="warning"] { border-left-color: @{warning}; }
QWidget#banner[kind="error"]   { border-left-color: @{error}; }
QLabel#bannerText { color: @{text}; }
QPushButton#bannerAction {
    background: @{accent};
    color: @{text.bright};
    border: none;
    border-radius: @{radius}px;
    padding: 4px 12px;
    font-weight: 600;
}
QPushButton#bannerAction:hover   { background: @{accent.hover}; }
QPushButton#bannerAction:pressed { background: @{accent.pressed}; }
QToolButton#bannerClose { padding: 2px; border-radius: 3px; }
QToolButton#bannerClose:hover { background: @{bg.hover}; }
QWidget#centralHost { background: @{bg.window}; }

/* ---------------- Preferences dialog ---------------------------------- */
QDialog#preferencesDialog { background: @{bg.window}; }
QListWidget#prefsNav {
    background: @{bg.base};
    border: none;
    border-right: 1px solid @{border};
    padding: 6px 4px;
    outline: none;
}
QListWidget#prefsNav::item {
    padding: 8px 10px;
    border-radius: @{radius}px;
    color: @{text.dim};
}
QListWidget#prefsNav::item:hover    { background: @{bg.hover}; color: @{text}; }
QListWidget#prefsNav::item:selected { background: @{selection}; color: @{text.bright}; }
QStackedWidget#prefsPages, QWidget#prefsPage { background: @{bg.panel}; }
QLabel#prefsHeading {
    font-size: @{font.size.heading}pt;
    font-weight: 600;
    color: @{text.bright};
    padding-bottom: 6px;
}
QLabel#prefsHint { color: @{text.dim}; }
QLabel#prefsStatus { font-weight: 600; }
QLabel#prefsStatus[state="good"] { color: @{success}; }
QLabel#prefsStatus[state="bad"]  { color: @{warning}; }
QWidget#prefsFooter { background: @{bg.window}; border-top: 1px solid @{border}; }

/* ---------------- Empty states ---------------------------------------- */
QWidget#emptyState { background: @{bg.panel}; }
QLabel#emptyStateTitle {
    font-size: @{font.size.heading}pt;
    font-weight: 600;
    color: @{text};
}
QLabel#emptyStateText { color: @{text.dim}; }
