{
  "id": "ue5_dark",
  "name": "Unreal Dark",
  "author": "C2UI",
  "description": "Unreal Engine 5 (Starship) inspired dark theme.",
  "variant": "dark",
  "qss": "base.qss",
  "tokens": {
    "font.family": "Segoe UI",
    "font.size": 9,
    "font.mono": "Consolas",
    "radius": 4,
    "radius.small": 3,
    "bg.window": "#151515",
    "bg.panel": "#1a1a1a",
    "bg.base": "#0f0f0f",
    "bg.header": "#242424",
    "bg.input": "#0d0d0d",
    "bg.hover": "#2a2a2a",
    "bg.pressed": "#0a0a0a",
    "bg.menu": "#1f1f1f",
    "bg.tooltip": "#2a2a2a",
    "bg.alt": "#1e1e1e",
    "bg.tab": "#151515",
    "bg.tab.active": "#242424",
    "bg.titlebar": "#0f0f0f",
    "bg.scrollbar": "#1a1a1a",
    "fg.scrollbar": "#3d3d3d",
    "border": "#0a0a0a",
    "border.light": "#2f2f2f",
    "border.focus": "#0070e0",
    "text": "#c0c0c0",
    "text.dim": "#808080",
    "text.bright": "#ffffff",
    "text.inverted": "#0f0f0f",
    "accent": "#0070e0",
    "accent.hover": "#47a0ff",
    "accent.pressed": "#0f5fa6",
    "selection": "#0070e0",
    "selection.inactive": "#0f5fa6",
    "warning": "#ffb800",
    "error": "#ef3535",
    "success": "#8bc24a",
    "icon.color": "#c0c0c0",
    "viewport.bg_top": "#22252a",
    "viewport.bg_bottom": "#0d0e10",
    "viewport.grid": "#2a2e34",
    "viewport.grid_major": "#3a3f47",
    "timeline.bg": "#161616",
    "timeline.header_bg": "#1f1f1f",
    "timeline.row": "#1a1a1a",
    "timeline.row_alt": "#1e1e1e",
    "timeline.ruler_bg": "#101010",
    "timeline.grid": "#262626",
    "timeline.grid_major": "#363636",
    "timeline.clip": "#2f5f8f",
    "timeline.clip_border": "#5a9ad8",
    "timeline.playhead": "#ef3535",
    "timeline.range": "#202020",
    "font.size.heading": 11
  },
  "palette": {
    "window": "@{bg.window}",
    "windowText": "@{text}",
    "base": "@{bg.base}",
    "alternateBase": "@{bg.alt}",
    "text": "@{text}",
    "button": "@{bg.header}",
    "buttonText": "@{text}",
    "brightText": "@{text.bright}",
    "highlight": "@{selection}",
    "highlightedText": "@{text.bright}",
    "toolTipBase": "@{bg.tooltip}",
    "toolTipText": "@{text}",
    "link": "@{accent.hover}",
    "placeholderText": "@{text.dim}",
    "light": "@{border.light}",
    "mid": "@{bg.header}",
    "dark": "@{bg.base}",
    "shadow": "#000000"
  }
}
