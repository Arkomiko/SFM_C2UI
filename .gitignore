# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Build output
build/
dist/
*.pyd

# Vendored SDKs: Valve's files are not redistributable, only the structure is
Core/dev-kit/sfm_sdk/*
Core/dev-kit/source_sdk/*
Core/dev-kit/source2_sdk/*
Core/dev-kit/steam_sdk/*
!Core/dev-kit/*/PLACE_SDK_HERE.md

# Runtime data: generated next to the app, never committed
App/Cache/*/*
App/Temporary/*
App/User/*/*
!App/User/*/.gitkeep
!App/Cache/*/.gitkeep

# Logs
*.log

# OS / editors
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
